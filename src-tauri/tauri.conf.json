{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoolerBox Tracker",
  "version": "0.2.2",
  "identifier": "com.coolerbox.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "library",
        "title": "Saved for offline",
        "width": 480,
        "height": 640,
        "minWidth": 380,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tracker"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDRUE2MUJGM0U3ODY2NDMKUldSRFpuZyt2MkhxekY1Snp2aTJPb2hMdmh3UDNQanVIZkVYRis3eHBLdzdpeFU2QkdBdysreksK",
      "endpoints": [
        "https://tracker.coolerboxbrothers.com/download/desktop/latest.json",
        "https://coolerboxbrothers.com/downloads/tracker/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  }
}
