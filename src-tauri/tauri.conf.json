{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoolerBox Tracker",
  "version": "0.1.0",
  "identifier": "com.coolerbox.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "library",
        "title": "Saved for offline",
        "width": 480,
        "height": 640,
        "minWidth": 380,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deepLink": {
      "desktop": {
        "schemes": ["tracker"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
